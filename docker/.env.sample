# Docker environment variables for Mayberry branch.
#
# Copy this to .env in the repo root, next to docker-compose.yaml, which is where
# compose looks for it. Fill in the required values, then run: docker compose up -d
#
#   cp docker/.env.sample .env
#
# See docker/README.md for complete documentation.

# REQUIRED: Your branch's public display name. Sanitized to create your public URL:
# https://<name>.branch.pub
MAYBERRY_NAME=

# REQUIRED: Absolute path to your EPUB library folder on the host. Will be mounted
# read-only at /library/books inside the container and scanned recursively.
MAYBERRY_LIBRARY_PATH=

# OPTIONAL: Host-side port the dashboard listens on. The container always listens
# on 1950 internally; this only controls the port mapping. Defaults to 1950.
# MAYBERRY_PORT=1950

# OPTIONAL: Catalog server URL (where your branch registers itself). Defaults to
# https://mayberry.pub. Set this only if you're running against a custom Mayberry
# catalog server.
# MAYBERRY_SERVER=https://mayberry.pub

# OPTIONAL: Tunnel hub URL (where the WebSocket tunnel terminates). Defaults to
# https://branch.pub. Set this only if you're running against a custom tunnel.
# MAYBERRY_HUB=https://branch.pub

# OPTIONAL: Enable network mirror (opt-in failover mirroring of other branches).
# If true, also uncomment the /library/_mirror volume in docker-compose.yaml and
# set MAYBERRY_MIRROR_PATH. Defaults to false. See docker/README.md for details.
# MAYBERRY_MIRROR_NETWORK=false

# OPTIONAL: Max disk space to use for mirrored books. Use K/M/G/T suffixes (e.g.
# 500M, 100G). Only applies if MAYBERRY_MIRROR_NETWORK=true. Defaults to 100G.
# MAYBERRY_MIRROR_SIZE=100G

# OPTIONAL: Comma-separated list of branch subdomains to mirror exclusively (whitelist).
# Only applies if MAYBERRY_MIRROR_NETWORK=true. Leave empty to mirror all branches.
# MAYBERRY_MIRROR_ONLY=

# OPTIONAL: Comma-separated list of branch subdomains to never mirror from (blocklist).
# Only applies if MAYBERRY_MIRROR_NETWORK=true. Leave empty to not block any.
# MAYBERRY_MIRROR_IGNORE=

# OPTIONAL: Mirror download speed preset. Valid values: slow, normal, fast.
# Only applies if MAYBERRY_MIRROR_NETWORK=true. Defaults to slow.
# MAYBERRY_MIRROR_RATE=slow

# OPTIONAL: Outbound bandwidth cap when serving mirror requests (e.g. 200K, 5M).
# Only applies if MAYBERRY_MIRROR_NETWORK=true. Defaults to 200K.
# MAYBERRY_MIRROR_SERVE_RATE=200K

# OPTIONAL: Host path where mirrored books are stored. Only consulted if the
# /library/_mirror volume line in docker-compose.yaml is uncommented. Defaults to
# ./data/mirror (relative to the repo directory). Ignored unless MAYBERRY_MIRROR_NETWORK=true.
# MAYBERRY_MIRROR_PATH=./data/mirror
